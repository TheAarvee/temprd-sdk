{
  "name": "@temprd/sdk",
  "version": "0.1.0",
  "description": "Universal reliability layer for AI agents",
  "license": "MIT",
  "author": "Temprd",
  "homepage": "https://temprd.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temprd/temprd-sdk.git"
  },
  "bugs": {
    "email": "support@temprd.app",
    "url": "https://temprd.app"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-reliability",
    "llm",
    "tool-calling",
    "healing",
    "runtime-protection",
    "temprd"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "dev": "tsc --watch",
    "production-test": "tsc examples/production-readiness/production-test.ts examples/production-readiness/fake-agent.ts examples/production-readiness/fake-tools.ts --module commonjs --target ES2020 --esModuleInterop --skipLibCheck --strict --outDir .production-readiness && node .production-readiness/examples/production-readiness/production-test.js"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.3.0"
  }
}
